# VORIXA Environment Configuration Template
# Copy to .env.local for local overrides

# Application Mode: development | test | production
VORIXA_ENV=development

# Rendering Backend: auto | webgpu | webgl2
VORIXA_RENDERER_BACKEND=auto

# Performance & Debug Overlays (1 = enabled, 0 = disabled)
VORIXA_DEBUG_OVERLAY=1
VORIXA_DEBUG_PHYSICS=0
VORIXA_LOG_LEVEL=info

# Audio Master Volume (0.0 to 1.0)
VORIXA_AUDIO_VOLUME=0.8
