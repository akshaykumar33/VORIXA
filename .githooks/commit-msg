#!/bin/sh
#
# VORIXA commit message validation — Conventional Commits v1.0.0.
# See docs/operations/GIT_WORKFLOW.md §3.

msg_file="$1"
# First non-comment, non-empty line is the subject.
subject="$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)"

# Merge, revert, and fixup commits are generated by git and exempt.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
scopes='repo|engine|render|ecs|input|audio|world|ui|ux|adr|vision|ci|test|deps|security'

if ! printf '%s' "$subject" | grep -Eq "^(${types})(\((${scopes})\))?!?: .+"; then
  printf '\033[31m✗ COMMIT BLOCKED — message is not a Conventional Commit.\033[0m\n'
  printf '\n'
  printf '  Received: \033[33m%s\033[0m\n' "$subject"
  printf '\n'
  printf '  Required: \033[1m<type>(<scope>): <lowercase description>\033[0m\n'
  printf '\n'
  printf '    types:  %s\n' "$types"
  printf '    scopes: %s\n' "$scopes"
  printf '\n'
  printf '  Example: \033[32mfeat(ui): add inventory grid with keyboard navigation\033[0m\n'
  printf '\n'
  printf '  See docs/operations/GIT_WORKFLOW.md §3\n'
  exit 1
fi

# Subject line length.
len=$(printf '%s' "$subject" | wc -c)
if [ "$len" -gt 72 ]; then
  printf '\033[31m✗ COMMIT BLOCKED — subject is %s characters (max 72).\033[0m\n' "$len"
  printf '  Move the detail into the commit body.\n'
  exit 1
fi

# Description must start lowercase and must not end with a period.
desc="$(printf '%s' "$subject" | sed -E "s/^(${types})(\([a-z-]+\))?!?: //")"
case "$desc" in
  [A-Z]*)
    printf '\033[31m✗ COMMIT BLOCKED — description must start lowercase.\033[0m\n'
    printf '  Received: %s\n' "$desc"
    exit 1
    ;;
esac
case "$desc" in
  *.)
    printf '\033[31m✗ COMMIT BLOCKED — description must not end with a period.\033[0m\n'
    exit 1
    ;;
esac

exit 0
