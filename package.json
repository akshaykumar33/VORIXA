{
  "name": "vorixa",
  "version": "0.1.0",
  "private": true,
  "description": "Next-generation, web-native, infinite procedural game and experimental game-engine platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "benchmark": "node scripts/benchmark.js",
    "hooks:install": "git config core.hooksPath .githooks && node -e \"process.platform!=='win32'&&require('fs').readdirSync('.githooks').forEach(f=>require('fs').chmodSync('.githooks/'+f,0o755))\"",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify": "pnpm verify:secrets --all && pnpm typecheck && pnpm test",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "setup:vision": "node scripts/fetch-vision-assets.mjs",
    "predev": "node scripts/fetch-vision-assets.mjs",
    "prebuild": "node scripts/fetch-vision-assets.mjs"
  },
  "keywords": [
    "webgpu",
    "webgl2",
    "game-engine",
    "procedural-generation",
    "ecs",
    "infinite-world",
    "vorixa"
  ],
  "author": "Akshay Kumar <akshaykumarpatil33@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^22.13.9",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.54",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vite": "^8.3.3",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0"
  },
  "pnpm": {
    "overrides": {
      "tinypool": ">=2.1.2",
      "source-map-js": ">=1.2.2"
    }
  }
}
